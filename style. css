/* ==========================================================
   ANIMEVERSE - style.css
   Dark neon theme: black backgrounds, purple and magenta glow.
   Sections in this file:
   1. Variables (colors, fonts)   2. Reset & base
   3. Header & navbar             4. Hero
   5. Buttons                     6. Content sections & cards
   7. Join section               8. Footer
   9. Responsive (tablet/phone)  10. Accessibility
   ========================================================== */


/* ---------- 1. VARIABLES ----------
   Change a color here and it updates across the whole site. */
:root {
  --bg: #07040d;              /* page background (near black) */
  --surface: #120a1f;         /* card and footer background */
  --surface-2: #1b0f2e;       /* slightly lighter purple-black */
  --border: #2d1b4a;          /* subtle outlines */
  --text: #f1e9ff;            /* main text */
  --text-muted: #a99bc4;      /* softer text */
  --neon: #b44cff;            /* main neon purple */
  --neon-pink: #ff3df2;       /* second neon color */
  --neon-cyan: #3df2ff;       /* small accent color */

  --glow: 0 0 12px rgba(180, 76, 255, 0.55), 0 0 32px rgba(180, 76, 255, 0.3);
  --radius: 14px;

  --font-heading: "Syne", "Segoe UI", sans-serif;
  --font-body: "DM Sans", "Segoe UI", Arial, sans-serif;
}


/* ---------- 2. RESET & BASE ---------- */
*,
*::before,
*::after {
  box-sizing: border-box;   /* padding and borders stay inside element width */
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;  /* smooth scrolling when clicking nav links */
  scroll-padding-top: 80px; /* keeps headings from hiding under the fixed header */
}

body {
  font-family: var(--font-body);
  font-size: 1rem;
  line-height: 1.65;
  color: var(--text);
  background-color: var(--bg);
  /* two soft neon glows in the background corners */
  background-image:
    radial-gradient(circle at 10% 0%, rgba(180, 76, 255, 0.18), transparent 40%),
    radial-gradient(circle at 90% 30%, rgba(255, 61, 242, 0.1), transparent 35%);
  background-repeat: no-repeat;
}

img {
  display: block;
  max-width: 100%;   /* images never overflow their container */
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

ul {
  list-style: none;
}

h1, h2, h3 {
  font-family: var(--font-heading);
  line-height: 1.15;
}


/* ---------- 3. HEADER & NAVBAR ---------- */
.site-header {
  position: sticky;          /* stays at the top while scrolling */
  top: 0;
  z-index: 100;
  background: rgba(7, 4, 13, 0.85);
  backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
}

.navbar {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0.9rem 1.5rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  font-family: var(--font-heading);
  font-weight: 800;
  font-size: 1.5rem;
  color: var(--text);
  text-shadow: 0 0 10px var(--neon), 0 0 24px rgba(180, 76, 255, 0.6);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 1.75rem;
}

.nav-links a {
  color: var(--text-muted);
  font-weight: 500;
  transition: color 0.2s, text-shadow 0.2s;
}

.nav-links a:hover {
  color: var(--text);
  text-shadow: 0 0 10px var(--neon);
}

/* The "Join the community" link styled like a neon button */
.nav-links .nav-button {
  color: var(--text);
  padding: 0.5rem 1.1rem;
  border: 1px solid var(--neon);
  border-radius: 999px;
  box-shadow: 0 0 10px rgba(180, 76, 255, 0.4);
}

.nav-links .nav-button:hover {
  background: var(--neon);
  box-shadow: var(--glow);
}

/* Menu button: hidden on desktop, shown on phones (see section 9) */
.menu-toggle {
  display: none;
  font: inherit;
  font-weight: 500;
  color: var(--text);
  background: transparent;
  border: 1px solid var(--neon);
  border-radius: 8px;
  padding: 0.4rem 0.9rem;
  cursor: pointer;
}


/* ---------- 4. HERO ---------- */
.hero {
  max-width: 1200px;
  margin: 0 auto;
  padding: 5rem 1.5rem 4rem;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;  /* text column + image column */
  gap: 3rem;
  align-items: center;
}

.hero h1 {
  font-size: clamp(2.6rem, 6vw, 4.6rem);  /* grows and shrinks with screen size */
  font-weight: 800;
  letter-spacing: -0.02em;
  text-shadow: 0 0 18px rgba(180, 76, 255, 0.75), 0 0 48px rgba(255, 61, 242, 0.35);
}

.hero-text {
  max-width: 34rem;
  margin-top: 1.5rem;
  font-size: 1.15rem;
  color: var(--text-muted);
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 2rem;
}

.hero-image img {
  width: 100%;
  border-radius: 24px;
  border: 1px solid var(--neon);
  box-shadow: var(--glow), 0 0 80px rgba(255, 61, 242, 0.15);
}


/* ---------- 5. BUTTONS ---------- */
.btn {
  display: inline-block;
  padding: 0.85rem 1.6rem;
  font-weight: 700;
  border-radius: 999px;
  border: 1px solid transparent;
  cursor: pointer;
  transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
}

.btn:hover {
  transform: translateY(-2px);
}

.btn-primary {
  color: #fff;
  background: linear-gradient(135deg, var(--neon), var(--neon-pink));
  box-shadow: var(--glow);
}

.btn-primary:hover {
  box-shadow: 0 0 18px rgba(255, 61, 242, 0.7), 0 0 44px rgba(180, 76, 255, 0.45);
}

.btn-secondary {
  color: var(--text);
  border-color: var(--neon-cyan);
  box-shadow: 0 0 10px rgba(61, 242, 255, 0.3);
}

.btn-secondary:hover {
  background: rgba(61, 242, 255, 0.1);
  box-shadow: 0 0 20px rgba(61, 242, 255, 0.5);
}


/* ---------- 6. CONTENT SECTIONS & CARDS ---------- */
.content-section {
  max-width: 1200px;
  margin: 0 auto;
  padding: 4rem 1.5rem;
}

.section-header {
  margin-bottom: 2rem;
}

.section-header h2 {
  font-size: clamp(1.9rem, 4vw, 2.6rem);
  font-weight: 800;
  text-shadow: 0 0 14px rgba(180, 76, 255, 0.55);
}

.section-header p {
  margin-top: 0.5rem;
  color: var(--text-muted);
}

/* Cards sit in a grid: as many 280px+ columns as will fit */
.card-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 1.75rem;
}

.card {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
}

.card:hover {
  transform: translateY(-6px);
  border-color: var(--neon);
  box-shadow: var(--glow);
}

.card img {
  width: 100%;
  object-fit: cover;   /* crops images neatly to fit */
}

.card figure {
  margin: 0;
}

.card-body {
  padding: 1.25rem 1.4rem 1.5rem;
}

.card-body h3 {
  font-size: 1.25rem;
  margin-bottom: 0.6rem;
}

.card-body p {
  color: var(--text-muted);
  font-size: 0.97rem;
}

.card-meta {
  margin-top: 0.75rem;
  font-size: 0.88rem;
  color: var(--neon-cyan);
}

.card-link {
  display: inline-block;
  margin-top: 1rem;
  font-weight: 700;
  color: var(--neon);
  border-bottom: 1px solid transparent;
  transition: color 0.2s, border-color 0.2s, text-shadow 0.2s;
}

.card-link:hover {
  color: var(--neon-pink);
  border-color: var(--neon-pink);
  text-shadow: 0 0 8px var(--neon-pink);
}

/* Video thumbnails (Anime Edits) with a duration badge in the corner */
.thumbnail {
  position: relative;
}

.duration {
  position: absolute;
  right: 0.75rem;
  bottom: 0.75rem;
  padding: 0.15rem 0.6rem;
  font-size: 0.82rem;
  font-weight: 700;
  color: #fff;
  background: rgba(7, 4, 13, 0.85);
  border: 1px solid var(--neon);
  border-radius: 6px;
}


/* ---------- 7. JOIN SECTION ---------- */
.join {
  max-width: 1000px;
  margin: 2rem auto 5rem;
  padding: 3.5rem 1.5rem;
  text-align: center;
  background: linear-gradient(160deg, var(--surface-2), var(--surface));
  border: 1px solid var(--neon);
  border-radius: 24px;
  box-shadow: var(--glow);
}

.join h2 {
  font-size: clamp(1.7rem, 4vw, 2.4rem);
  font-weight: 800;
}

.join p {
  max-width: 34rem;
  margin: 1rem auto 2rem;
  color: var(--text-muted);
}


/* ---------- 8. FOOTER ---------- */
.site-footer {
  background: var(--surface);
  border-top: 1px solid var(--border);
  padding: 3rem 1.5rem 1.5rem;
}

.footer-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 2rem;
}

.footer-brand p {
  max-width: 20rem;
  margin-top: 0.6rem;
  color: var(--text-muted);
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem 1.5rem;
}

.footer-links a {
  color: var(--text-muted);
  transition: color 0.2s, text-shadow 0.2s;
}

.footer-links a:hover {
  color: var(--neon);
  text-shadow: 0 0 8px var(--neon);
}

.copyright {
  max-width: 1200px;
  margin: 2rem auto 0;
  padding-top: 1.25rem;
  border-top: 1px solid var(--border);
  font-size: 0.88rem;
  color: var(--text-muted);
}


/* ---------- 9. RESPONSIVE ---------- */

/* Tablets and smaller: stack the hero into one column */
@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
    padding-top: 3rem;
  }

  .hero-image {
    order: -1;   /* image appears above the text on small screens */
  }
}

/* Phones: show the Menu button and turn links into a dropdown */
@media (max-width: 700px) {
  .menu-toggle {
    display: block;
  }

  .nav-links {
    display: none;               /* hidden until the Menu button is clicked */
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.25rem 1.5rem 1.5rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  /* script.js adds the class "open" to show the menu */
  .nav-links.open {
    display: flex;
  }

  .content-section {
    padding: 3rem 1.25rem;
  }

  .join {
    margin: 1rem 1.25rem 4rem;
  }
}


/* ---------- 10. ACCESSIBILITY ---------- */

/* Clear neon outline for keyboard users */
a:focus-visible,
button:focus-visible {
  outline: 2px solid var(--neon-cyan);
  outline-offset: 3px;
}

/* Turns off animations for people who prefer reduced motion */
@media (prefers-reduced-motion: reduce) {
  * {
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
