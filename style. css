
/* ========================================
   ANIMEVERSE — MAIN DESIGN
   Dark anime-inspired theme
======================================== */

:root {
  --bg: #090910;
  --surface: #131321;
  --surface-light: #1c1b2d;
  --purple: #a855f7;
  --purple-light: #c084fc;
  --blue: #6366f1;
  --text: #f5f3ff;
  --muted: #aaa7c0;
  --border: rgba(192, 132, 252, 0.18);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 90px;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: "DM Sans", sans-serif;
  line-height: 1.7;
}

img {
  display: block;
  width: 100%;
  object-fit: cover;
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

::selection {
  background: var(--purple);
  color: white;
}

/* HEADER AND NAVIGATION */

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(9, 9, 16, 0.92);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border);
}

.navbar {
  width: min(1200px, 92%);
  min-height: 76px;
  margin: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.logo {
  font-family: "Syne", sans-serif;
  font-size: 1.65rem;
  font-weight: 800;
  letter-spacing: -1px;
  color: var(--purple-light);
}

.nav-links {
  list-style: none;
  display: flex;
  align-items: center;
  gap: 28px;
}

.nav-links a,
.footer-links a {
  color: var(--muted);
  transition: color 0.25s ease;
}

.nav-links a:hover,
.footer-links a:hover {
  color: var(--purple-light);
}

.nav-links .nav-button {
  padding: 10px 17px;
  border: 1px solid var(--purple);
  border-radius: 10px;
  color: var(--text);
}

.nav-links .nav-button:hover {
  background: var(--purple);
  color: white;
}

.menu-toggle {
  display: none;
  background: var(--surface-light);
  color: white;
  border: 1px solid var(--border);
  border-radius: 9px;
  padding: 9px 14px;
  cursor: pointer;
}

/* HERO SECTION */

.hero {
  width: min(1200px, 92%);
  min-height: 570px;
  margin: 45px auto 80px;
  padding: 55px;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 45px;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 28px;
  background:
    radial-gradient(
      circle at 15% 20%,
      rgba(126, 34, 206, 0.22),
      transparent 45%
    ),
    linear-gradient(135deg, #151326, #0d0d18);
}

.hero-content {
  position: relative;
  z-index: 1;
}

.hero h1 {
  font-family: "Syne", sans-serif;
  font-size: clamp(2.6rem, 5vw, 4.7rem);
  line-height: 1.12;
  letter-spacing: -2px;
  margin-bottom: 24px;
  background: linear-gradient(
    110deg,
    #ffffff,
    #d8b4fe,
    #818cf8
  );
  background-clip: text;
  -webkit-background-clip: text;
  color: transparent;
}

.hero-text {
  max-width: 540px;
  color: var(--muted);
  font-size: 1.05rem;
  margin-bottom: 30px;
}

.hero-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 13px 21px;
  border-radius: 11px;
  font-weight: 700;
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.btn:hover {
  transform: translateY(-3px);
}

.btn-primary {
  background: linear-gradient(135deg, #9333ea, #6366f1);
  color: white;
  box-shadow: 0 8px 28px rgba(147, 51, 234, 0.24);
}

.btn-primary:hover {
  box-shadow: 0 10px 35px rgba(147, 51, 234, 0.42);
}

.btn-secondary {
  border: 1px solid var(--border);
  background: rgba(255, 255, 255, 0.035);
}

.btn-secondary:hover {
  border-color: var(--purple);
}

.hero-image {
  min-width: 0;
}

.hero-image img {
  height: 430px;
  border-radius: 20px;
  border: 1px solid var(--border);
  box-shadow: 0 0 55px rgba(147, 51, 234, 0.15);
}

/* CONTENT SECTIONS */

.content-section {
  width: min(1200px, 92%);
  margin: 0 auto 100px;
}

.section-header {
  margin-bottom: 30px;
}

.section-header h2,
.join h2 {
  font-family: "Syne", sans-serif;
  font-size: clamp(1.8rem, 4vw, 2.6rem);
  line-height: 1.25;
  margin-bottom: 10px;
}

.section-header p,
.join p {
  color: var(--muted);
}

/* CONTENT CARD GRID */

.card-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.card {
  min-width: 0;
  overflow: hidden;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 18px;
  transition:
    transform 0.3s ease,
    border-color 0.3s ease,
    box-shadow 0.3s ease;
}

.card:hover {
  transform: translateY(-6px);
  border-color: rgba(192, 132, 252, 0.6);
  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.25);
}

.card > img,
.card figure > img {
  height: 225px;
}

.card figure {
  margin: 0;
}

.card-body {
  padding: 22px;
}

.card-body h3 {
  font-family: "Syne", sans-serif;
  font-size: 1.15rem;
  line-height: 1.4;
  margin-bottom: 10px;
}

.card-body > p:not(.card-meta) {
  color: var(--muted);
  font-size: 0.95rem;
}

.card-meta {
  color: var(--muted);
  font-size: 0.82rem;
  margin: 14px 0;
}

.card-link {
  display: inline-block;
  margin-top: 8px;
  color: var(--purple-light);
  font-weight: 700;
}

.card-link:hover {
  color: white;
  text-decoration: underline;
}

/* VIDEO EDIT THUMBNAILS */

.thumbnail {
  position: relative;
  overflow: hidden;
}

.thumbnail img {
  height: 205px;
  transition: transform 0.4s ease;
}

.card:hover .thumbnail img {
  transform: scale(1.05);
}

.duration {
  position: absolute;
  right: 12px;
  bottom: 12px;
  padding: 3px 8px;
  border-radius: 5px;
  background: rgba(0, 0, 0, 0.8);
  color: white;
  font-size: 0.8rem;
}

/* JOIN COMMUNITY */

.join {
  width: min(1200px, 92%);
  margin: 0 auto 90px;
  padding: 65px 24px;
  text-align: center;
  border: 1px solid var(--border);
  border-radius: 24px;
  background:
    radial-gradient(
      ellipse at top,
      rgba(126, 34, 206, 0.2),
      transparent 70%
    ),
    var(--surface);
}

.join p {
  max-width: 600px;
  margin: 0 auto 25px;
}

/* FOOTER */

.site-footer {
  padding: 45px 0 20px;
  border-top: 1px solid var(--border);
  background: #07070d;
}

.footer-inner {
  width: min(1200px, 92%);
  margin: auto;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 30px;
}

.footer-brand {
  max-width: 350px;
}

.footer-brand p {
  color: var(--muted);
  margin-top: 10px;
}

.footer-links {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
}

.copyright {
  width: min(1200px, 92%);
  margin: 30px auto 0;
  padding-top: 20px;
  border-top: 1px solid var(--border);
  text-align: center;
  color: var(--muted);
  font-size: 0.85rem;
}

/* TABLETS */

@media (max-width: 900px) {
  .hero {
    min-height: auto;
    padding: 35px;
    gap: 25px;
  }

  .hero-image img {
    height: 350px;
  }

  .card-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .nav-links {
    gap: 15px;
  }
}

/* PHONES */

@media (max-width: 640px) {
  .navbar {
    min-height: 68px;
    flex-wrap: wrap;
    padding: 12px 0;
  }

  .logo {
    font-size: 1.4rem;
  }

  .menu-toggle {
    display: block;
  }

  .nav-links {
    display: none;
    width: 100%;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 8px 0;
  }

  .nav-links.open {
    display: flex;
  }

  .nav-links li a {
    display: block;
    padding: 12px;
  }

  .hero {
    width: 92%;
    margin: 24px auto 65px;
    padding: 27px 22px;
    grid-template-columns: 1fr;
    border-radius: 20px;
    gap: 28px;
  }

  .hero h1 {
    font-size: clamp(2.35rem, 11vw, 3.4rem);
    letter-spacing: -1.3px;
  }

  .hero-image img {
    height: 300px;
  }

  .hero-buttons {
    flex-direction: column;
  }

  .btn {
    width: 100%;
  }

  .content-section {
    margin-bottom: 70px;
  }

  .card-grid {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .card > img,
  .card figure > img {
    height: 240px;
  }

  .thumbnail img {
    height: 220px;
  }

  .join {
    padding: 45px 22px;
    margin-bottom: 65px;
  }

  .footer-inner {
    flex-direction: column;
  }

  .footer-links {
    flex-direction: column;
    gap: 8px;
  }
}

/* REDUCE ANIMATIONS FOR USERS WHO PREFER IT */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}
